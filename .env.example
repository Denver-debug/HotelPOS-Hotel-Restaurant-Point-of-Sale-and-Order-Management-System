# HotelPOS environment configuration. Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=3000

APP_NAME=HotelPOS
# MySQL session/connection timezone used for "today" and report date boundaries
APP_TIMEZONE=+08:00
CURRENCY_SYMBOL=₱

# Long random string. Required when NODE_ENV=production.
SESSION_SECRET=
# Set to true when served over HTTPS
COOKIE_SECURE=false
SESSION_TTL_MINUTES=480

DB_HOST=localhost
DB_PORT=3306
DB_NAME=HotelPOS
DB_USER=root
DB_PASSWORD=
DB_TEST_NAME=HotelPOS_test

# Password for the seeded "admin" account. A random one is printed when empty.
SEED_ADMIN_PASSWORD=

# ── Integrations ───────────────────────────────────────────────────────────
# PMS (Front Desk / Property Management System): mock | http
PMS_ADAPTER=mock
PMS_BASE_URL=
PMS_API_KEY=
PMS_TIMEOUT_MS=8000
# Simulated latency for the mock PMS timeout scenario (room 306)
PMS_MOCK_DELAY_MS=0

# Payment provider: mock (no real provider integrated yet)
PAYMENT_ADAPTER=mock
PAYMENT_BASE_URL=
PAYMENT_API_KEY=
PAYMENT_TIMEOUT_MS=15000

# HR and Staff Payroll: mock | http
HR_ADAPTER=mock
HR_BASE_URL=
HR_API_KEY=
HR_TIMEOUT_MS=5000
HR_VALIDATE_ON_LOGIN=true

# ── ERP integration API (/api/v1) ──────────────────────────────────────────
# API keys are created in System → Integrations → API clients (never in this file).
# Browser origins allowed to call /api/v1 with an API key (comma-separated; empty = none).
API_CORS_ORIGINS=
# Requests per minute per API key (0 = no limit).
API_RATE_LIMIT_PER_MINUTE=600
# Behind a reverse proxy / load balancer: Express "trust proxy" (true, a hop count like 1,
# or loopback) so client IPs (audit log, API key IP allowlists) are the real ones.
TRUST_PROXY=
