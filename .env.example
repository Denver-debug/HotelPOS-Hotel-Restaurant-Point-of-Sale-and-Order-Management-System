# HotelPOS environment configuration. Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=3000

APP_NAME=HotelPOS
# MySQL session/connection timezone used for "today" and report date boundaries
APP_TIMEZONE=+08:00
CURRENCY_SYMBOL=₱
# ISO 4217 code sent to the PMS/payment provider and included in events
CURRENCY_CODE=PHP

# Long random string. Required when NODE_ENV=production.
SESSION_SECRET=
# Set to true when served over HTTPS
COOKIE_SECURE=false
SESSION_TTL_MINUTES=480

DB_HOST=localhost
DB_PORT=3306
DB_NAME=HotelPOS
DB_USER=root
DB_PASSWORD=
DB_TEST_NAME=HotelPOS_test

# Password for the seeded "admin" account. A random one is printed when empty.
SEED_ADMIN_PASSWORD=

# ── Integrations ───────────────────────────────────────────────────────────
# PMS (Front Desk / Property Management System): mock | frontdesk | http
#   frontdesk: the hotel's Frontdesk system (docs/INTEGRATIONS.md), e.g.
#   PMS_BASE_URL=https://frontdesk.dineai.site/api/v1/integrations
PMS_ADAPTER=mock
PMS_BASE_URL=
# The POS API key issued by the Frontdesk administrator
PMS_API_KEY=
PMS_TIMEOUT_MS=8000
# frontdesk: request signing secret (the Frontdesk's POS_INBOUND_SECRET), when it requires signed requests
PMS_INBOUND_SECRET=
# frontdesk: secret of the Frontdesk's webhooks to https://<this host>/webhooks/pms (its POS_WEBHOOK_SECRET)
PMS_WEBHOOK_SECRET=
# frontdesk: restaurant_id sent for every outlet (empty: each outlet's code, e.g. RS-01)
PMS_RESTAURANT_ID=
# frontdesk: how often charges awaiting front-desk review are checked when no webhook came (0 = off)
PMS_REVIEW_POLL_MS=120000
# Simulated latency for the mock PMS timeout scenario (room 306)
PMS_MOCK_DELAY_MS=0

# Payment provider for GCash and Maya: mock | paymongo
#   paymongo: the POS shows a QR code and the guest approves on their phone (docs/INTEGRATIONS.md)
PAYMENT_ADAPTER=mock
# PayMongo secret key: sk_test_… (no real money) or sk_live_…
PAYMENT_API_KEY=
# Signing secret of the PayMongo webhook for /webhooks/paymongo (optional; the POS also polls)
PAYMENT_WEBHOOK_SECRET=
# Page the guest's phone opens after paying (default http://localhost:PORT/pay/complete)
PAYMENT_RETURN_URL=
# Defaults to https://api.paymongo.com/v1 for paymongo
PAYMENT_BASE_URL=
PAYMENT_TIMEOUT_MS=15000

# HR and Staff Payroll: mock | http
HR_ADAPTER=mock
HR_BASE_URL=
HR_API_KEY=
HR_TIMEOUT_MS=5000
HR_VALIDATE_ON_LOGIN=true

# ── ERP integration API (/api/v1) ──────────────────────────────────────────
# API keys are created in System → Integrations → API clients (never in this file).
# Browser origins allowed to call /api/v1 with an API key (comma-separated; empty = none).
API_CORS_ORIGINS=
# Requests per minute per API key (0 = no limit).
API_RATE_LIMIT_PER_MINUTE=600
# Behind a reverse proxy / load balancer: Express "trust proxy" (true, a hop count like 1,
# or loopback) so client IPs (audit log, API key IP allowlists) are the real ones.
TRUST_PROXY=

# ── ERP events (transactional outbox) ──────────────────────────────────────
# log: record events as delivered (no endpoint yet) | webhook: POST each event, signed, to the ERP.
# Other systems can always pull them from GET /api/v1/events as well.
EVENTS_PUBLISHER=log
EVENTS_WEBHOOK_URL=
# Shared secret for the X-HotelPOS-Signature HMAC (at least 16 characters).
EVENTS_WEBHOOK_SECRET=
EVENTS_TIMEOUT_MS=10000
# How often the background dispatcher runs (0 = only when "Dispatch now" is pressed).
EVENTS_DISPATCH_INTERVAL_MS=15000
# Failed deliveries back off (30 s, 1 min, 2 min … up to 1 h) and stop after this many attempts.
EVENTS_MAX_ATTEMPTS=10
EVENTS_BATCH_SIZE=50
