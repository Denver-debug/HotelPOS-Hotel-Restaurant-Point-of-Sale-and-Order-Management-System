<div class="{{#if currentUser}}mx-auto max-w-xl py-12{{/if}}">
  <div class="card p-8 text-center">
    <p class="text-sm font-semibold text-accent-600">{{status}}</p>
    <h2 class="mt-2 text-2xl font-semibold text-slate-900">{{title}}</h2>
    <p class="mt-3 text-sm text-slate-600">{{message}}</p>
    <div class="mt-6 flex justify-center gap-2">
      <button type="button" class="btn btn-secondary" data-history-back>Go back</button>
      <a href="{{#if currentUser}}/dashboard{{else}}/login{{/if}}" class="btn btn-primary">{{#if currentUser}}Dashboard{{else}}Sign in{{/if}}</a>
    </div>
    {{#if requestId}}<p class="mt-4 text-xs text-slate-400">Reference: <span class="font-mono">{{requestId}}</span></p>{{/if}}
    {{#if stack}}<pre class="mt-6 max-h-64 overflow-auto rounded bg-slate-900 p-3 text-left text-xs text-slate-100">{{stack}}</pre>{{/if}}
  </div>
</div>
