{{#> page-header heading="Orders" subtitle="Search and filter orders across your outlets."}}
  {{#if (can "pos.access")}}<a href="/pos/terminal" class="btn btn-primary">{{icon "terminal" "w-4 h-4"}}POS terminal</a>{{/if}}
{{/page-header}}
<div class="card">
  <form class="grid gap-3 border-b border-slate-100 p-4 sm:grid-cols-3 lg:grid-cols-8" method="GET">
    <input class="input lg:col-span-2" type="search" name="search" value="{{filters.search}}" placeholder="Order number">
    <select class="input" name="outletId" data-autosubmit>
      <option value="">All outlets</option>
      {{#each outlets}}<option value="{{id}}" {{selected id ../filters.outletId}}>{{name}}</option>{{/each}}
    </select>
    <select class="input" name="status" data-autosubmit>
      <option value="">All statuses</option>
      {{#each statuses}}<option value="{{this}}" {{selected this ../filters.status}}>{{humanize this}}</option>{{/each}}
    </select>
    <select class="input" name="orderType" data-autosubmit>
      <option value="">All types</option>
      {{#each types}}<option value="{{this}}" {{selected this ../filters.orderType}}>{{humanize this}}</option>{{/each}}
    </select>
    <select class="input" name="settlementType" data-autosubmit>
      <option value="">Any settlement</option>
      <option value="DIRECT_PAYMENT" {{selected "DIRECT_PAYMENT" filters.settlementType}}>Direct payment</option>
      <option value="ROOM_CHARGE" {{selected "ROOM_CHARGE" filters.settlementType}}>Room charge</option>
    </select>
    <input class="input" type="date" name="from" value="{{filters.from}}" aria-label="From">
    <div class="flex gap-2"><input class="input" type="date" name="to" value="{{filters.to}}" aria-label="To"><button class="btn btn-secondary" type="submit">Go</button></div>
    <select class="input lg:col-span-2" name="cashierId" data-autosubmit>
      <option value="">Any staff member</option>
      {{#each cashiers}}<option value="{{id}}" {{selected id ../filters.cashierId}}>{{fullName}}</option>{{/each}}
    </select>
  </form>
  {{#if orders.length}}
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>Order</th><th>Date</th><th>Outlet</th><th>Type</th><th>Location</th><th>Created by</th><th>Settlement</th><th class="text-right">Total</th><th>Status</th></tr></thead>
      <tbody>
        {{#each orders}}
        <tr>
          <td><a class="font-mono text-xs font-medium text-brand-700 hover:underline" href="/orders/{{id}}">{{orderNumber}}</a></td>
          <td class="whitespace-nowrap text-xs">{{datetime createdAt}}</td>
          <td>{{outlet.code}}</td>
          <td>{{humanize orderType}}</td>
          <td>{{default tableOrLocation "—"}}</td>
          <td>{{creator.fullName}}</td>
          <td>{{#if settlementType}}{{statusBadge settlementType (humanize settlementType)}}{{else}}—{{/if}}</td>
          <td class="text-right font-medium">{{money totalAmount}}</td>
          <td>{{statusBadge status}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
  {{else}}
    {{> empty-state message="No orders match your filters." hint="Adjust the date range or filters." icon="clipboard"}}
  {{/if}}
  {{> pagination}}
</div>
