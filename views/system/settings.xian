{{#> page-header heading="Settings" subtitle="POS-specific configuration. Credentials and connection details live in environment variables, never in the database."}}{{/page-header}}
<div class="grid gap-6 lg:grid-cols-3">
  <form class="card lg:col-span-2" method="POST" action="/settings">
    <input type="hidden" name="_csrf" value="{{csrfToken}}">
    <div class="card-header"><h3 class="card-title">POS settings</h3></div>
    <div class="card-body space-y-5">
      {{#each posSettings}}
      <div>
        {{#if (eq valueType "boolean")}}
          <label class="flex items-start gap-3 text-sm"><input type="checkbox" name="{{settingKey}}" value="1" class="mt-0.5 h-4 w-4 rounded border-slate-300" {{#if (eq settingValue "true")}}checked{{/if}}><span><span class="font-medium text-slate-800">{{label}}</span><span class="block text-xs text-slate-500">{{description}}</span></span></label>
        {{else}}
          <label class="label" for="s-{{settingKey}}">{{label}}</label>
          {{#if (eq valueType "text")}}
            <textarea class="input" id="s-{{settingKey}}" name="{{settingKey}}" rows="2">{{settingValue}}</textarea>
          {{else}}
            <input class="input" id="s-{{settingKey}}" name="{{settingKey}}" value="{{settingValue}}" {{#if (eq valueType "number")}}type="number" min="1" max="100"{{/if}}>
          {{/if}}
          <p class="help">{{description}}</p>
        {{/if}}
      </div>
      {{/each}}
    </div>
    <div class="flex justify-end border-t border-slate-200 px-5 py-4"><button class="btn btn-primary" type="submit">Save settings</button></div>
  </form>
  <div class="card h-fit">
    <div class="card-header"><h3 class="card-title">Environment</h3></div>
    <dl class="card-body dl">
      <dt>Application</dt><dd>{{env.appName}}</dd>
      <dt>Timezone</dt><dd>{{env.timezone}}</dd>
      <dt>Currency</dt><dd>{{env.currency}}</dd>
      <dt>Environment</dt><dd>{{env.environment}}</dd>
      <dt>Database</dt><dd>{{env.database}}</dd>
    </dl>
    <p class="border-t border-slate-200 px-5 py-3 text-xs text-slate-500">Change these in <code>.env</code> and restart the server.</p>
  </div>
</div>

<div class="card mt-6" id="payment-methods">
  <div class="card-header"><h3 class="card-title">Payment methods</h3><span class="text-xs text-slate-500">Card / e-wallet methods use the payment gateway adapter</span></div>
  <div class="hidden gap-3 border-b border-slate-200 bg-slate-100 px-5 py-3 text-xs font-semibold uppercase tracking-wide text-slate-500 md:grid md:grid-cols-[5rem_minmax(0,1fr)_7rem_8rem_5rem_8rem_5rem]" aria-hidden="true">
    <span>Code</span><span>Name</span><span>Type</span><span>Reference</span><span>Order</span><span>Status</span><span></span>
  </div>
  <div class="divide-y divide-slate-200">
    {{#each methods}}
    <form class="grid grid-cols-2 items-center gap-3 px-5 py-3 md:grid-cols-[5rem_minmax(0,1fr)_7rem_8rem_5rem_8rem_5rem]" method="POST" action="/settings/payment-methods/{{id}}" data-confirm="Deactivate {{name}}? It disappears from every POS terminal immediately." data-confirm-when='[name="status"]=INACTIVE' data-confirm-label="Deactivate">
      <input type="hidden" name="_csrf" value="{{../csrfToken}}">
      <span class="col-span-2 font-mono text-xs md:col-span-1">{{code}}</span>
      <input class="input col-span-2 md:col-span-1" name="name" value="{{name}}" maxlength="60" aria-label="Name of {{code}}">
      <span class="text-sm text-slate-600">{{#if isCash}}Cash drawer{{else}}{{#if usesGateway}}Gateway{{else}}Manual{{/if}}{{/if}}</span>
      <label class="flex items-center gap-2 text-sm"><input type="checkbox" name="requiresReference" value="1" {{checked requiresReference}}>Reference required</label>
      <input class="input w-full md:w-20" name="sortOrder" type="number" min="0" value="{{sortOrder}}" aria-label="Display order of {{code}}">
      <select class="input" name="status" aria-label="Status of {{code}}"><option value="ACTIVE" {{selected "ACTIVE" status}}>Active</option><option value="INACTIVE" {{selected "INACTIVE" status}}>Inactive</option></select>
      <button class="btn btn-secondary btn-sm col-span-2 justify-self-end md:col-span-1" type="submit">Save</button>
    </form>
    {{else}}
    {{> empty-state message="No payment methods are configured." icon="card"}}
    {{/each}}
  </div>
</div>
