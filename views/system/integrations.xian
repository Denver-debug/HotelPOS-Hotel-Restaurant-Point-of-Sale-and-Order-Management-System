{{#> page-header heading="Integrations" subtitle="Connections to other Hotel ERP subsystems. MOCK adapters simulate a system for development only."}}{{/page-header}}

<div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
  {{#each adapters}}
  <div class="card p-5">
    <div class="flex items-start justify-between gap-2">
      <div><p class="text-xs uppercase tracking-wide text-slate-500">{{system}}</p><h3 class="mt-1 font-semibold text-slate-900">{{name}}</h3></div>
      {{#if isMock}}<span class="badge badge-amber">MOCK</span>{{else}}<span class="badge badge-green">LIVE</span>{{/if}}
    </div>
    <dl class="mt-4 space-y-1 text-xs">
      <div class="flex justify-between"><dt class="text-slate-500">Adapter</dt><dd class="font-mono">{{adapter}}</dd></div>
      <div class="flex justify-between"><dt class="text-slate-500">Endpoint</dt><dd>{{default endpoint "not configured"}}</dd></div>
      <div class="flex justify-between"><dt class="text-slate-500">Credentials</dt><dd>{{#if credentials}}set (env){{else}}none{{/if}}</dd></div>
      {{#if timeoutMs}}<div class="flex justify-between"><dt class="text-slate-500">Timeout</dt><dd>{{timeoutMs}} ms</dd></div>{{/if}}
      <div class="flex justify-between border-t border-slate-200 pt-1"><dt class="text-slate-500">Last 24 h</dt><dd>{{#if health}}{{health.calls}} calls · <span class="{{#if (gt health.failed 0)}}text-rose-600{{/if}}">{{health.failed}} failed</span> · {{health.avg_ms}} ms avg{{else}}no calls{{/if}}</dd></div>
    </dl>
  </div>
  {{/each}}
</div>

<div class="mt-6 grid gap-6 xl:grid-cols-3">
  <div class="card xl:col-span-2">
    <div class="card-header"><h3 class="card-title">Request &amp; response log</h3><span class="text-xs text-slate-500">Secrets are masked</span></div>
    <form class="filter-bar" method="GET">
      <select aria-label="System" class="input" name="system" data-autosubmit>
        <option value="">All systems</option>
        <option value="PMS" {{selected "PMS" filters.system}}>PMS</option>
        <option value="PAYMENT" {{selected "PAYMENT" filters.system}}>Payment</option>
        <option value="HR" {{selected "HR" filters.system}}>HR</option>
        <option value="EVENT" {{selected "EVENT" filters.system}}>Events</option>
      </select>
      <select aria-label="Status" class="input" name="status" data-autosubmit>
        <option value="">All results</option>
        <option value="SUCCESS" {{selected "SUCCESS" filters.status}}>Success</option>
        <option value="FAILED" {{selected "FAILED" filters.status}}>Failed</option>
        <option value="TIMEOUT" {{selected "TIMEOUT" filters.status}}>Timeout</option>
        <option value="ERROR" {{selected "ERROR" filters.status}}>Error</option>
      </select>
      <button class="btn btn-secondary" type="submit">Filter</button>
    </form>
    {{#if logs.length}}
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>Time</th><th>System</th><th>Operation</th><th>Reference</th><th class="text-right">ms</th><th>Result</th><th></th></tr></thead>
        <tbody>
          {{#each logs}}
          <tr>
            <td class="whitespace-nowrap text-xs">{{datetime createdAt}}</td>
            <td>{{systemName}}{{#if isMock}} <span class="badge badge-slate">MOCK</span>{{/if}}</td>
            <td class="font-mono text-xs">{{operation}}</td>
            <td class="text-xs">{{referenceType}} {{referenceId}}</td>
            <td class="text-right text-xs">{{durationMs}}</td>
            <td>{{statusBadge status}}</td>
            <td class="text-right"><a class="text-xs text-brand-700 hover:underline" href="/integrations/logs/{{id}}">Details</a></td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
    {{else}}
      {{> empty-state message="No integration calls recorded." icon="plug"}}
    {{/if}}
    {{> pagination}}
  </div>

  <div class="card h-fit">
    <div class="card-header"><h3 class="card-title">Event outbox</h3>
      {{#if canManage}}
      <form method="POST" action="/integrations/events/dispatch" data-confirm="Send all pending events to the ERP now?" data-confirm-danger="false" data-confirm-label="Dispatch"><input type="hidden" name="_csrf" value="{{csrfToken}}"><button class="btn btn-secondary btn-sm" type="submit">Dispatch pending</button></form>
      {{/if}}
    </div>
    <div class="card-body space-y-3 text-sm">
      <div class="grid grid-cols-3 gap-2 text-center">
        <div class="rounded-lg bg-amber-50 p-2"><p class="text-xs text-amber-700">Pending</p><p class="text-lg font-semibold">{{default outbox.PENDING 0}}</p></div>
        <div class="rounded-lg bg-emerald-50 p-2"><p class="text-xs text-emerald-700">Published</p><p class="text-lg font-semibold">{{default outbox.PUBLISHED 0}}</p></div>
        <div class="rounded-lg bg-rose-50 p-2"><p class="text-xs text-rose-700">Failed</p><p class="text-lg font-semibold">{{default outbox.FAILED 0}}</p></div>
      </div>
      <p class="text-xs text-slate-500">Events such as <code>OrderCompleted</code> are written in the same transaction as the sale. No event bus is configured yet, so dispatching uses a MOCK publisher.</p>
      <ul class="divide-y divide-slate-200">
        {{#each events}}<li class="flex items-center justify-between py-2 text-xs"><span><span class="font-mono">{{eventType}}</span> · {{aggregateType}} {{aggregateId}}</span>{{statusBadge status}}</li>{{else}}<li class="py-3 text-xs text-slate-500">No events recorded yet. Completed sales and refunds add them.</li>{{/each}}
      </ul>
    </div>
  </div>
</div>
