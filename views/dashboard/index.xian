{{#> page-header heading=(concat "Welcome, " currentUser.fullName) subtitle=(concat currentUser.roleName " · " (default hotelName ""))}}
  <form method="GET" class="flex flex-wrap items-center gap-2">
    <select class="input w-auto" name="outletId" data-autosubmit aria-label="Outlet">
      <option value="">All my outlets</option>
      {{#each outlets}}<option value="{{id}}" {{selected id ../filters.outletId}}>{{name}}</option>{{/each}}
    </select>
    <input class="input w-auto" type="date" name="date" value="{{filters.date}}" data-autosubmit aria-label="Business date">
  </form>
{{/page-header}}

{{#if openShift}}
<div class="mb-6 flex flex-wrap items-center gap-4 rounded-xl border border-emerald-200 bg-emerald-50 px-5 py-4 text-sm text-emerald-900">
  <span class="flex items-center gap-2 font-semibold">{{icon "clock" "w-5 h-5"}}Your shift {{openShift.shiftNumber}} · {{openShift.outlet.name}}</span>
  <span>Opened {{datetime openShift.openedAt}}</span>
  <span>Opening cash {{money openShift.openingCash}}</span>
  <span>Expected cash now <strong>{{money shiftCash.expected}}</strong></span>
  <a href="/shifts/{{openShift.id}}" class="ml-auto font-medium underline">Shift details</a>
</div>
{{else}}
  {{#if (can "shifts.open")}}
  <div class="mb-6 flex items-center gap-3 rounded-xl border border-amber-200 bg-amber-50 px-5 py-3 text-sm text-amber-900">
    {{icon "alert" "w-5 h-5"}}<span>You have no open cashier shift. Open one before taking payments.</span>
    <a href="/shifts/open" class="btn btn-primary btn-sm ml-auto">Open shift</a>
  </div>
  {{/if}}
{{/if}}

{{#if showSales}}
<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-5">
  <div class="stat"><p class="stat-label">{{#if isToday}}Today's sales{{else}}Sales{{/if}}</p><p class="stat-value">{{money summary.grossSales}}</p><p class="mt-1 text-xs text-slate-500">Net of refunds {{money summary.netSales}}</p></div>
  <div class="stat"><p class="stat-label">Transactions</p><p class="stat-value">{{summary.orders}}</p><p class="mt-1 text-xs text-slate-500">Avg. ticket {{money summary.averageTicket}}</p></div>
  <div class="stat"><p class="stat-label">Direct payments</p><p class="stat-value">{{money summary.directPayments.amount}}</p><p class="mt-1 text-xs text-slate-500">{{summary.directPayments.count}} payments</p></div>
  <div class="stat"><p class="stat-label">Guest room charges</p><p class="stat-value">{{money summary.roomCharges.amount}}</p><p class="mt-1 text-xs text-slate-500">{{summary.roomCharges.count}} posted to folios</p></div>
  <div class="stat"><p class="stat-label">Refunds</p><p class="stat-value">{{money summary.refunds.amount}}</p><p class="mt-1 text-xs text-slate-500">{{summary.refunds.count}} processed · {{summary.voids.count}} voids</p></div>
</div>

<div class="mt-6 grid gap-6 xl:grid-cols-3">
  <div class="card xl:col-span-2">
    <div class="card-header"><h3 class="card-title">Sales trend · last 7 days</h3><a href="/reports/sales" class="text-sm text-brand-700 hover:underline">Sales report</a></div>
    <div class="card-body"><div class="relative h-64 w-full overflow-hidden"><canvas id="chart-trend" aria-label="Daily sales for the last 7 days" role="img"></canvas></div></div>
  </div>
  <div class="card">
    <div class="card-header"><h3 class="card-title">Settlement mix</h3><a href="/reports/payments" class="text-sm text-brand-700 hover:underline">Details</a></div>
    <div class="card-body">
      {{#if methods.length}}
      <div class="relative h-48 w-full overflow-hidden"><canvas id="chart-methods" aria-label="Amount by payment method" role="img"></canvas></div>
      <table class="mt-3 w-full text-sm"><tbody>{{#each methods}}<tr><td class="py-1 text-slate-600">{{method}}</td><td class="py-1 text-right font-medium">{{money amount}}</td></tr>{{/each}}</tbody></table>
      {{else}}{{> empty-state message="No settlements yet." icon="card"}}{{/if}}
    </div>
  </div>
</div>

<div class="mt-6 grid gap-6 xl:grid-cols-3">
  <div class="card">
    <div class="card-header"><h3 class="card-title">Sales by outlet</h3></div>
    <div class="card-body">
      {{#if byOutlet.length}}
      <div class="relative h-48 w-full overflow-hidden"><canvas id="chart-outlets" aria-label="Sales by outlet" role="img"></canvas></div>
      <table class="mt-3 w-full text-sm"><tbody>{{#each byOutlet}}<tr><td class="py-1 text-slate-600">{{name}}</td><td class="py-1 text-right text-slate-500">{{orders}} orders</td><td class="py-1 text-right font-medium">{{money amount}}</td></tr>{{/each}}</tbody></table>
      {{else}}{{> empty-state message="No completed sales." icon="building"}}{{/if}}
    </div>
  </div>
  <div class="card">
    <div class="card-header"><h3 class="card-title">Best sellers</h3><a href="/reports/products" class="text-sm text-brand-700 hover:underline">All products</a></div>
    {{#if bestSellers.length}}
    <ol class="divide-y divide-slate-200">
      {{#each bestSellers}}
      <li class="flex items-center gap-3 px-5 py-3 text-sm"><span class="flex h-7 w-7 items-center justify-center rounded-full bg-brand-50 text-xs font-semibold text-brand-700">{{add @index 1}}</span><span class="flex-1">{{name}}<span class="block text-xs text-slate-500">{{category}}</span></span><span class="text-right"><span class="font-semibold">{{qty quantity}}</span> sold<span class="block text-xs text-slate-500">{{money amount}}</span></span></li>
      {{/each}}
    </ol>
    {{else}}{{> empty-state message="No items sold." icon="tag"}}{{/if}}
  </div>
  <div class="card">
    <div class="card-header"><h3 class="card-title">Recent transactions</h3><a href="/orders" class="text-sm text-brand-700 hover:underline">All orders</a></div>
    {{#if recent.length}}
    <ul class="divide-y divide-slate-200">
      {{#each recent}}
      <li class="flex items-center gap-3 px-5 py-3 text-sm">
        <a href="/orders/{{id}}" class="flex-1"><span class="font-mono text-xs text-brand-700">{{order_number}}</span><span class="block text-xs text-slate-500">{{outlet_code}} · {{datetime updated_at}}{{#if room_number}} · Room {{room_number}}{{/if}}</span></a>
        <span class="text-right font-medium">{{money total_amount}}<span class="block">{{statusBadge status}}</span></span>
      </li>
      {{/each}}
    </ul>
    {{else}}{{> empty-state message="No transactions yet." icon="clipboard"}}{{/if}}
  </div>
</div>
{{/if}}

{{#if showInventory}}
<div class="card mt-6">
  <div class="card-header"><h3 class="card-title flex items-center gap-2">{{icon "alert" "w-5 h-5 text-amber-600"}}Low-stock items</h3><a href="/inventory?low=1" class="text-sm text-brand-700 hover:underline">Inventory</a></div>
  {{#if lowStock.length}}
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>Item</th><th>Outlet</th><th class="text-right">On hand</th><th class="text-right">Reorder level</th><th>Status</th></tr></thead>
      <tbody>{{#each lowStock}}<tr><td>{{name}} <span class="font-mono text-xs text-slate-400">{{sku}}</span></td><td>{{outlet_name}}</td><td class="text-right font-semibold">{{qty quantity}} {{unit}}</td><td class="text-right">{{qty reorder_level}}</td><td>{{#if (lt quantity 0.001)}}<span class="badge badge-red">Out of stock</span>{{else}}<span class="badge badge-amber">Low</span>{{/if}}</td></tr>{{/each}}</tbody>
    </table>
  </div>
  {{else}}
    {{> empty-state message="All stock levels are above their reorder points." icon="box"}}
  {{/if}}
</div>
{{/if}}

{{#if charts}}
<script type="application/json" id="dashboard-charts">{{json charts}}</script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js" defer></script>
<script src="/js/charts.js" defer></script>
{{/if}}
