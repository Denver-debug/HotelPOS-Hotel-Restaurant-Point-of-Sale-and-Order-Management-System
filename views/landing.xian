<!-- Top navigation -->
<header class="absolute inset-x-0 top-0 z-20">
  <div class="mx-auto flex max-w-7xl items-center gap-3 px-4 py-5 sm:px-6 lg:px-8">
    <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-accent-500 text-white shadow-lg">{{icon "key" "w-5 h-5"}}</span>
    <div class="leading-tight">
      <p class="font-semibold text-white">{{default appName "HotelPOS"}}</p>
      <p class="text-xs text-brand-200">{{hotelName}}</p>
    </div>
    <nav class="ml-auto flex items-center gap-1 sm:gap-2" aria-label="Landing">
      <a href="#features" class="hidden rounded-lg px-3 py-2 text-sm text-brand-100 hover:bg-white/10 hover:text-white sm:inline-block">Features</a>
      <a href="#how-it-works" class="hidden rounded-lg px-3 py-2 text-sm text-brand-100 hover:bg-white/10 hover:text-white sm:inline-block">How it works</a>
      <a href="/login" class="btn btn-accent ml-1">Staff sign in {{icon "arrow" "w-4 h-4"}}</a>
    </nav>
  </div>
</header>

<!-- Hero -->
<section class="relative flex min-h-[88vh] items-center overflow-hidden bg-brand-950 pb-20 pt-32 sm:pb-28 sm:pt-40">
  <img src="/images/hotel-resort.jpg" alt="" class="absolute inset-0 h-full w-full object-cover">
  <div class="absolute inset-0 bg-gradient-to-r from-brand-950/90 via-brand-950/75 to-brand-950/50 lg:via-brand-950/60 lg:to-brand-950/10"></div>
  <div class="absolute inset-x-0 top-0 h-32 bg-gradient-to-b from-brand-950/60 to-transparent"></div>
  <div class="relative mx-auto grid w-full max-w-7xl items-center gap-14 px-4 sm:px-6 lg:grid-cols-2 lg:px-8">
    <div>
      <p class="inline-flex items-center gap-2 rounded-full bg-white/15 px-3 py-1 text-xs font-medium text-accent-100 ring-1 ring-white/25 backdrop-blur">
        <span class="h-1.5 w-1.5 rounded-full bg-accent-400"></span>{{hotelName}} · Restaurant &amp; outlet point-of-sale
      </p>
      <h1 class="mt-6 text-4xl font-semibold leading-tight tracking-tight text-white sm:text-5xl">
        Every outlet.<br><span class="text-accent-300">One point of sale.</span>
      </h1>
      <p class="mt-6 max-w-xl text-lg text-brand-100">
        Take orders at the restaurant, bar, room service, minibar and spa, then settle each one by direct payment
        or charge it straight to the guest's room folio, validated in real time by the front desk.
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-3">
        <a href="/login" class="btn btn-accent btn-lg">Sign in to the POS {{icon "arrow" "w-5 h-5"}}</a>
        <a href="#how-it-works" class="btn btn-lg bg-white/10 text-white ring-1 ring-white/30 backdrop-blur hover:bg-white/20">See how it works</a>
      </div>
      <p class="mt-6 text-sm text-brand-200">For hotel staff. Accounts are issued by your system administrator.</p>
    </div>

    <!-- Illustrative room-charge slip -->
    <div class="relative mx-auto w-full max-w-sm lg:mx-0 lg:justify-self-end" aria-hidden="true">
      <div class="absolute -inset-6 rounded-[2rem] bg-accent-500/10 blur-2xl"></div>
      <div class="relative rotate-1 rounded-2xl bg-white p-6 shadow-2xl ring-1 ring-black/5">
        <div class="flex items-center justify-between text-xs text-slate-400"><span>In-Room Dining</span><span class="font-mono">ORD-0042</span></div>
        <div class="mt-4 space-y-2 text-sm">
          <div class="flex justify-between"><span>1 × Club Sandwich</span><span class="font-medium">₱520.00</span></div>
          <div class="flex justify-between"><span>2 × Iced Tea</span><span class="font-medium">₱330.00</span></div>
        </div>
        <div class="mt-4 flex justify-between border-t border-dashed border-slate-200 pt-4 text-base font-semibold"><span>Total</span><span>₱850.00</span></div>
        <div class="mt-5 rounded-xl border-2 border-brand-900 py-3 text-center text-sm font-bold tracking-wide text-brand-900">CHARGED TO ROOM 205</div>
        <div class="mt-4 flex items-center gap-2 rounded-lg bg-emerald-50 px-3 py-2 text-xs text-emerald-800">{{icon "check" "w-4 h-4"}}Folio validated and posted by the PMS</div>
        <p class="mt-3 text-center text-[11px] text-slate-400">Example receipt</p>
      </div>
    </div>
  </div>
</section>

<!-- Outlets -->
{{#if outlets.length}}
<section class="border-b border-slate-200 bg-slate-50 py-10" aria-label="Outlets">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <p class="text-center text-xs font-semibold uppercase tracking-widest text-slate-500">Serving our outlets</p>
    <ul class="mt-6 flex flex-wrap justify-center gap-3">
      {{#each outlets}}
      <li class="flex items-center gap-3 rounded-full bg-white px-4 py-2 text-sm text-slate-700 shadow-sm ring-1 ring-slate-200">
        <span class="text-accent-600">{{icon icon "w-5 h-5"}}</span>{{name}}
      </li>
      {{/each}}
    </ul>
  </div>
</section>
{{/if}}

<!-- Features -->
<section id="features" class="py-20 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-semibold tracking-tight text-slate-900">Built for the way hotel outlets work</h2>
      <p class="mt-4 text-slate-600">One system for front-of-house speed and back-office control, connected to the rest of the hotel ERP.</p>
    </div>
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
        <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-50 text-brand-700">{{icon "terminal" "w-6 h-6"}}</span>
        <h3 class="mt-5 font-semibold text-slate-900">Fast touch-friendly terminal</h3>
        <p class="mt-2 text-sm text-slate-600">Category tabs, search and barcode entry, item notes and keyboard shortcuts, with outlet-specific prices.</p>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
        <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-accent-50 text-accent-700">{{icon "door" "w-6 h-6"}}</span>
        <h3 class="mt-5 font-semibold text-slate-900">Charge to the guest's room</h3>
        <p class="mt-2 text-sm text-slate-600">Room, guest and active folio are confirmed with the PMS before posting, and duplicate charges are prevented.</p>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
        <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-50 text-brand-700">{{icon "card" "w-6 h-6"}}</span>
        <h3 class="mt-5 font-semibold text-slate-900">Every way to pay</h3>
        <p class="mt-2 text-sm text-slate-600">Cash with change, card, e-wallet and bank transfer, plus split payments and printable receipts.</p>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
        <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-50 text-brand-700">{{icon "box" "w-6 h-6"}}</span>
        <h3 class="mt-5 font-semibold text-slate-900">Outlet inventory</h3>
        <p class="mt-2 text-sm text-slate-600">Stock is deducted automatically per sale or recipe, with low-stock alerts and a full movement history.</p>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
        <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-50 text-brand-700">{{icon "shield" "w-6 h-6"}}</span>
        <h3 class="mt-5 font-semibold text-slate-900">Controls that hold up</h3>
        <p class="mt-2 text-sm text-slate-600">Cashier shifts with cash variance, supervisor approvals for voids, discounts and refunds, and a tamper-proof audit trail.</p>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
        <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-50 text-brand-700">{{icon "chart" "w-6 h-6"}}</span>
        <h3 class="mt-5 font-semibold text-slate-900">Live reports</h3>
        <p class="mt-2 text-sm text-slate-600">Sales by outlet, product and cashier, the settlement mix and room charges, with CSV export for accounting.</p>
      </div>
    </div>
  </div>
</section>

<!-- How it works -->
<section id="how-it-works" class="bg-slate-50 py-20 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-semibold tracking-tight text-slate-900">From order to folio in four steps</h2>
      <p class="mt-4 text-slate-600">Guests order the way they always have: at the table, at the bar, at the spa desk, or by calling room service. Staff do the rest on the terminal.</p>
    </div>
    <ol class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      <li class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
        <span class="text-sm font-semibold text-accent-600">01</span>
        <h3 class="mt-2 font-semibold text-slate-900">The guest orders</h3>
        <p class="mt-2 text-sm text-slate-600">In person at an outlet, or by phone to room service.</p>
      </li>
      <li class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
        <span class="text-sm font-semibold text-accent-600">02</span>
        <h3 class="mt-2 font-semibold text-slate-900">Staff ring it up</h3>
        <p class="mt-2 text-sm text-slate-600">Items, notes and discounts go on the POS terminal; totals, VAT and service charge are calculated automatically.</p>
      </li>
      <li class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
        <span class="text-sm font-semibold text-accent-600">03</span>
        <h3 class="mt-2 font-semibold text-slate-900">Settle it</h3>
        <p class="mt-2 text-sm text-slate-600">Take a direct payment, or enter the room number and post the charge once the PMS confirms the guest's folio.</p>
      </li>
      <li class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
        <span class="text-sm font-semibold text-accent-600">04</span>
        <h3 class="mt-2 font-semibold text-slate-900">Done everywhere</h3>
        <p class="mt-2 text-sm text-slate-600">A receipt prints, stock updates, and the sale appears in reports and the cashier's shift.</p>
      </li>
    </ol>
  </div>
</section>

<!-- Call to action -->
<section class="relative overflow-hidden py-20">
  <img src="/images/hotel-lobby.jpg" alt="" class="absolute inset-0 h-full w-full object-cover">
  <div class="absolute inset-0 bg-brand-900/80"></div>
  <div class="relative mx-auto flex max-w-7xl flex-col items-center gap-6 px-4 text-center sm:px-6 lg:flex-row lg:justify-between lg:text-left lg:px-8">
    <div>
      <h2 class="text-2xl font-semibold text-white">Ready for your shift?</h2>
      <p class="mt-2 text-brand-200">Sign in with the account issued by your administrator.</p>
    </div>
    <a href="/login" class="btn btn-accent btn-lg">Staff sign in {{icon "arrow" "w-5 h-5"}}</a>
  </div>
</section>

<footer class="border-t border-slate-200 bg-white py-8 text-center text-xs text-slate-500">
  © {{year}} {{hotelName}} · {{default appName "HotelPOS"}}, a Hotel ERP subsystem built on the XianFire framework
</footer>
