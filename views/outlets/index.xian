{{#> page-header heading="Outlets" subtitle="Hotel-operated points of sale. Each outlet has its own prices, inventory and assigned staff."}}
  <a href="/outlets/new" class="btn btn-primary">{{icon "plus" "w-4 h-4"}}New outlet</a>
{{/page-header}}
<div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
  {{#each outlets}}
  <a href="/outlets/{{id}}" class="card block p-5 transition hover:border-brand-300 hover:shadow-md">
    <div class="flex items-start justify-between gap-3">
      <div>
        <p class="font-mono text-xs text-slate-400">{{code}}</p>
        <h3 class="mt-1 text-base font-semibold text-slate-900">{{name}}</h3>
        <p class="text-sm text-slate-500">{{humanize outlet_type}}{{#if location}} · {{location}}{{/if}}</p>
      </div>
      {{statusBadge status}}
    </div>
    <dl class="mt-4 grid grid-cols-3 gap-2 text-center text-xs">
      <div class="rounded-lg bg-slate-50 p-2"><dt class="text-slate-500">Products</dt><dd class="mt-1 text-base font-semibold text-slate-900">{{product_count}}</dd></div>
      <div class="rounded-lg bg-slate-50 p-2"><dt class="text-slate-500">Staff</dt><dd class="mt-1 text-base font-semibold text-slate-900">{{user_count}}</dd></div>
      <div class="rounded-lg bg-slate-50 p-2"><dt class="text-slate-500">Open shifts</dt><dd class="mt-1 text-base font-semibold text-slate-900">{{open_shifts}}</dd></div>
    </dl>
    <p class="mt-3 text-xs text-slate-500">Service charge {{service_charge_rate}}% · Room charge {{#if allows_room_charge}}allowed{{else}}not allowed{{/if}}</p>
  </a>
  {{else}}
  <div class="card md:col-span-2 xl:col-span-3">{{> empty-state message="No outlets yet." icon="building"}}</div>
  {{/each}}
</div>
