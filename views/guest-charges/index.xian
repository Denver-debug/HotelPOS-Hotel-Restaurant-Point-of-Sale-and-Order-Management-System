{{#> page-header heading="Guest Room Charges" subtitle="Charges posted to guest folios through the PMS. Only external PMS references are stored."}}{{/page-header}}
<div class="card">
  <form class="filter-bar" method="GET">
    <input aria-label="Room, charge no. or PMS reference" class="input filter-wide" type="search" name="search" value="{{filters.search}}" placeholder="Room, charge no. or PMS reference">
    <select aria-label="Outlet" class="input" name="outletId" data-autosubmit>
      <option value="">All outlets</option>
      {{#each outlets}}<option value="{{id}}" {{selected id ../filters.outletId}}>{{name}}</option>{{/each}}
    </select>
    <select aria-label="Status" class="input" name="status" data-autosubmit>
      <option value="">All statuses</option>
      {{#each statuses}}<option value="{{this}}" {{selected this ../filters.status}}>{{humanize this}}</option>{{/each}}
    </select>
    <input class="input" type="date" name="from" value="{{filters.from}}" aria-label="From">
    <input class="input" type="date" name="to" value="{{filters.to}}" aria-label="To">
    <button class="btn btn-secondary" type="submit">Filter</button>
  </form>
  {{#if charges.length}}
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>Charge</th><th>Date</th><th>Order</th><th>Outlet</th><th>Room</th><th>Folio</th><th>PMS reference</th><th class="text-right">Amount</th><th>Status</th></tr></thead>
      <tbody>
        {{#each charges}}
        <tr>
          <td><a class="font-mono text-xs text-brand-700 hover:underline" href="/guest-charges/{{id}}">{{chargeNumber}}</a>{{#if isMock}} <span class="badge badge-slate">MOCK</span>{{/if}}</td>
          <td class="whitespace-nowrap text-xs">{{datetime createdAt}}</td>
          <td><a class="font-mono text-xs text-brand-700 hover:underline" href="/orders/{{order.id}}">{{order.orderNumber}}</a></td>
          <td class="whitespace-nowrap">{{order.outlet.code}}</td>
          <td class="font-semibold">{{roomNumber}}</td>
          <td class="font-mono text-xs">{{externalFolioId}}</td>
          <td class="font-mono text-xs">{{default pmsTransactionId "—"}}</td>
          <td class="text-right font-medium">{{money amount}}{{#if (gt reversedAmount 0)}}<div class="text-xs text-rose-600">−{{money reversedAmount}}</div>{{/if}}</td>
          <td>{{statusBadge status}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
  {{else}}
    {{> empty-state message="No room charges in this period." icon="key"}}
  {{/if}}
  {{> pagination}}
</div>
