{{#> page-header heading="Refunds & Voids" subtitle="Refunds reverse completed sales; voids cancel orders before any money was collected."}}{{/page-header}}
<nav class="mb-6 flex gap-1 border-b border-slate-200">
  <a href="/refunds?tab=refunds" class="-mb-px border-b-2 px-4 py-2 text-sm font-medium {{#if (eq tab "refunds")}}border-brand-700 text-brand-800{{else}}border-transparent text-slate-500 hover:text-slate-800{{/if}}">Refunds</a>
  <a href="/refunds?tab=voids" class="-mb-px border-b-2 px-4 py-2 text-sm font-medium {{#if (eq tab "voids")}}border-brand-700 text-brand-800{{else}}border-transparent text-slate-500 hover:text-slate-800{{/if}}">Voided orders</a>
</nav>
<div class="card">
  <form class="filter-bar" method="GET">
    <input type="hidden" name="tab" value="{{tab}}">
    {{#if (eq tab "refunds")}}
    <select class="input" name="status" data-autosubmit>
      <option value="">All statuses</option>
      <option value="REQUESTED" {{selected "REQUESTED" filters.status}}>Awaiting approval</option>
      <option value="PROCESSED" {{selected "PROCESSED" filters.status}}>Processed</option>
      <option value="REJECTED" {{selected "REJECTED" filters.status}}>Rejected</option>
      <option value="FAILED" {{selected "FAILED" filters.status}}>Failed</option>
    </select>
    {{/if}}
    <input class="input" type="date" name="from" value="{{filters.from}}" aria-label="From">
    <input class="input" type="date" name="to" value="{{filters.to}}" aria-label="To">
    <button class="btn btn-secondary" type="submit">Go</button>
  </form>
  {{#if rows.length}}
  <div class="table-wrap">
    {{#if (eq tab "refunds")}}
    <table class="table">
      <thead><tr><th>Refund</th><th>Requested</th><th>Order</th><th>Outlet</th><th>Type</th><th>Reason</th><th>Requested by</th><th>Approved by</th><th class="text-right">Amount</th><th>Status</th></tr></thead>
      <tbody>
        {{#each rows}}
        <tr>
          <td><a class="font-mono text-xs text-brand-700 hover:underline" href="/refunds/{{id}}">{{refundNumber}}</a></td>
          <td class="whitespace-nowrap text-xs">{{datetime createdAt}}</td>
          <td><a class="font-mono text-xs text-brand-700 hover:underline" href="/orders/{{order.id}}">{{order.orderNumber}}</a></td>
          <td class="whitespace-nowrap">{{order.outlet.code}}</td>
          <td>{{humanize refundType}} · {{#if (eq settlementType "ROOM_CHARGE")}}Room{{else}}Direct{{/if}}</td>
          <td class="max-w-xs truncate text-sm" title="{{reason}}">{{reason}}</td>
          <td>{{requester.fullName}}</td>
          <td>{{default approver.fullName "—"}}</td>
          <td class="text-right font-medium">{{money amount}}</td>
          <td>{{statusBadge status}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{else}}
    <table class="table">
      <thead><tr><th>Order</th><th>Voided</th><th>Outlet</th><th>Created by</th><th>Approved by</th><th>Reason</th><th class="text-right">Order total</th></tr></thead>
      <tbody>
        {{#each rows}}
        <tr>
          <td><a class="font-mono text-xs text-brand-700 hover:underline" href="/orders/{{id}}">{{orderNumber}}</a></td>
          <td class="whitespace-nowrap text-xs">{{datetime voidedAt}}</td>
          <td class="whitespace-nowrap">{{outlet.code}}</td>
          <td>{{creator.fullName}}</td>
          <td>{{voider.fullName}}</td>
          <td class="text-sm">{{voidReason}}</td>
          <td class="text-right">{{money totalAmount}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{/if}}
  </div>
  {{else}}
    {{> empty-state message="Nothing in this period." icon="undo"}}
  {{/if}}
  {{> pagination}}
</div>
