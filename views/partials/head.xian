<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="csrf-token" content="{{csrfToken}}">
<title>{{#if title}}{{title}} · {{/if}}{{default appName "HotelPOS"}}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">
<script src="https://cdn.tailwindcss.com/3.4.16"></script>
<script>
  tailwind.config = {
    theme: {
      extend: {
        fontFamily: { sans: ["Inter", "ui-sans-serif", "system-ui", "sans-serif"] },
        // Palette anchors: deep green #233E35 (brand-800 / slate-800-900), darker sage #365446
        // (brand-700, hover), ivory #FAF9F6, soft sage #EEF1E9 (slate-100), light gray #DEDFD7
        // (slate-200), muted green #45584E (slate-500), muted gold #9A7A43 (accent-500),
        // terracotta #923E2C (rose-600). Other steps are interpolated between them.
        colors: {
          ivory: "#FAF9F6",
          brand: { 50: "#EEF1E9", 100: "#DCE3D9", 200: "#B9C8BC", 300: "#93AB9C", 400: "#7A9A87", 500: "#4F705F", 600: "#3F5F4F", 700: "#365446", 800: "#233E35", 900: "#1B3029", 950: "#12211C" },
          accent: { 50: "#F8F4EC", 100: "#EFE6D3", 200: "#E0CDA8", 300: "#CBAE78", 400: "#B39256", 500: "#9A7A43", 600: "#806434", 700: "#67502A", 800: "#523F22", 900: "#3F311B" },
          slate: { 50: "#F5F6F1", 100: "#EEF1E9", 200: "#DEDFD7", 300: "#CBCEC3", 400: "#8C978F", 500: "#45584E", 600: "#3E5147", 700: "#34483E", 800: "#233E35", 900: "#233E35", 950: "#172A23" },
          rose: { 50: "#F8EEEB", 100: "#F0D9D3", 200: "#E2B3A8", 300: "#CD8676", 400: "#B3604D", 500: "#A04C38", 600: "#923E2C", 700: "#7A3324", 800: "#62291D", 900: "#4C2017", 950: "#2E130E" },
        },
      },
    },
  };
</script>
<style type="text/tailwindcss">
  @layer components {
    .btn { @apply inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-medium transition focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-1 disabled:opacity-50 disabled:cursor-not-allowed whitespace-nowrap; }
    .btn-primary { @apply bg-brand-800 text-white hover:bg-brand-700 focus-visible:ring-brand-500; }
    .btn-accent { @apply bg-accent-500 text-white hover:bg-accent-600 focus-visible:ring-accent-400; }
    .btn-secondary { @apply bg-white text-slate-800 border border-slate-300 hover:bg-slate-100 focus-visible:ring-brand-400; }
    .btn-cancel { @apply bg-white text-rose-600 border border-rose-600/40 hover:bg-rose-50 hover:border-rose-600 focus-visible:ring-rose-400; }
    .btn-danger { @apply bg-rose-600 text-white hover:bg-rose-700 focus-visible:ring-rose-400; }
    .btn-success { @apply bg-emerald-600 text-white hover:bg-emerald-700 focus-visible:ring-emerald-400; }
    .btn-ghost { @apply text-slate-600 hover:bg-slate-100 focus-visible:ring-brand-400; }
    .btn-sm { @apply px-2.5 py-1.5 text-xs; }
    .btn-lg { @apply px-5 py-3 text-base; }
    .card { @apply min-w-0 bg-white rounded-xl border border-slate-200 shadow-sm; }
    .card-header { @apply px-5 py-4 border-b border-slate-200 flex items-center justify-between gap-3; }
    .card-title { @apply text-base font-semibold text-slate-900; }
    .card-body { @apply p-5; }
    .label { @apply block text-sm font-medium text-slate-700 mb-1; }
    .input { @apply block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 placeholder-slate-400 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/20 disabled:bg-slate-50; }
    .help { @apply mt-1 text-xs text-slate-500; }
    /* Filter row above a data table: fields wrap onto new lines instead of squeezing,
       and buttons keep their natural width so they never spill past the card edge. */
    .filter-bar { @apply flex flex-wrap items-center gap-3 border-b border-slate-200 p-4; }
    .filter-bar > * { flex: 1 1 10rem; min-width: 0; }
    .filter-bar > .filter-wide { flex: 2 1 16rem; }
    .filter-bar > .btn { flex: 0 0 auto; }
    .table-wrap { @apply overflow-x-auto; }
    .table { @apply w-full text-sm text-slate-800; }
    .table thead th { @apply border-b border-slate-200 bg-slate-100 px-4 py-3 text-xs font-semibold uppercase tracking-wide text-slate-500 whitespace-nowrap; }
    .table tbody td { @apply border-t border-slate-200 px-4 py-3 align-middle; }
    .table tbody tr:first-child td { @apply border-t-0; }
    .table tbody tr:hover { @apply bg-slate-50; }
    .badge { @apply inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium ring-1 ring-inset whitespace-nowrap; }
    .badge-green { @apply bg-emerald-50 text-emerald-700 ring-emerald-600/20; }
    .badge-blue { @apply bg-brand-50 text-brand-700 ring-brand-600/20; }
    .badge-amber { @apply bg-amber-50 text-amber-800 ring-amber-600/20; }
    .badge-red { @apply bg-rose-50 text-rose-700 ring-rose-600/20; }
    .badge-slate { @apply bg-slate-100 text-slate-600 ring-slate-500/20; }
    .stat { @apply card p-5; }
    .stat-label { @apply text-xs font-medium uppercase tracking-wide text-slate-500; }
    .stat-value { @apply mt-2 text-2xl font-semibold text-slate-900; }
    .nav-link { @apply flex items-center gap-3 rounded-lg px-3 py-2 text-sm text-brand-100 hover:bg-white/10 hover:text-white transition; }
    .nav-link-active { @apply bg-white/10 text-white font-medium; }
    .dl { @apply grid grid-cols-3 gap-x-4 gap-y-2 text-sm; }
    .dl dt { @apply text-slate-500; }
    .dl dd { @apply col-span-2 text-slate-900; }
  }
</style>
<link rel="stylesheet" href="/css/app.css">
