{{!-- POS terminal dialogs. Content is filled in by public/js/pos-terminal.js.
     Every dialog: the panel is capped to the viewport and its body scrolls, [data-primary]
     is what Enter triggers, Esc closes, and key badges come from pos-shortcuts.js. --}}

<!-- Direct payment -->
<div id="modal-payment" class="pos-modal fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/60 p-4" role="dialog" aria-modal="true" aria-labelledby="payment-title">
  <div class="flex max-h-full w-full max-w-lg flex-col rounded-2xl bg-white shadow-2xl">
    <div class="flex shrink-0 items-center justify-between border-b border-slate-200 px-6 py-4">
      <h2 id="payment-title" class="text-lg font-semibold">Direct payment</h2>
      <button type="button" class="btn btn-ghost p-2" data-modal-close aria-label="Close" data-shortcut="dialog-close" data-shortcut-hint="none">{{icon "x"}}</button>
    </div>
    <div class="scroll-thin min-h-0 space-y-4 overflow-y-auto px-6 py-5">
      <div class="flex items-center justify-between rounded-xl bg-brand-50 px-4 py-3">
        <span class="text-sm text-brand-700">Balance due</span><span id="pay-due" class="text-2xl font-semibold text-brand-900">0.00</span>
      </div>
      <div>
        <p class="label flex items-center justify-between">Payment method <span class="pos-hint text-xs font-normal text-slate-500" data-kbd-for="pay-method-1" data-label="… 9"></span></p>
        <div id="pay-methods" class="grid grid-cols-2 gap-2 sm:grid-cols-3"></div>
        <p id="pay-mock-note" class="mt-2 hidden text-xs text-amber-700">Mock payment gateway: no real card or e-wallet is charged. Use reference <code>DECLINE</code> to simulate a decline.</p>
      </div>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        <div>
          <label class="label" for="pay-amount">Amount to apply</label>
          <input id="pay-amount" type="number" min="0.01" step="0.01" inputmode="decimal" class="input text-lg">
        </div>
        <div id="pay-tendered-wrap">
          <label class="label flex items-center justify-between" for="pay-tendered">Cash received <span class="pos-hint text-xs font-normal text-slate-500" data-kbd-for="pay-tender-step" data-kbd-all data-label="quick amounts"></span></label>
          <input id="pay-tendered" type="number" min="0" step="0.01" inputmode="decimal" class="input text-lg">
        </div>
      </div>
      <div id="pay-quick" class="flex flex-wrap gap-2"></div>
      <div id="pay-reference-wrap" class="hidden">
        <label class="label" for="pay-reference">Reference / approval code</label>
        <input id="pay-reference" class="input" maxlength="100" autocomplete="off">
      </div>
      <div class="flex items-center justify-between rounded-lg bg-slate-50 px-4 py-2 text-sm"><span>Change</span><span id="pay-change" class="text-lg font-semibold">0.00</span></div>
      <p id="pay-error" class="hidden rounded-lg bg-rose-50 px-3 py-2 text-sm text-rose-700" role="alert"></p>
    </div>
    <div class="flex shrink-0 justify-end gap-2 rounded-b-2xl bg-slate-50 px-6 py-4">
      <button type="button" class="btn btn-cancel" data-modal-close data-shortcut="dialog-close">Cancel</button>
      <button type="button" id="pay-submit" class="btn btn-primary btn-lg" data-primary data-shortcut="dialog-primary"><span data-label>Confirm payment</span></button>
    </div>
  </div>
</div>

<!-- Charge to room (PMS) -->
<div id="modal-room" class="pos-modal fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/60 p-4" role="dialog" aria-modal="true" aria-labelledby="room-title">
  <div class="flex max-h-full w-full max-w-lg flex-col rounded-2xl bg-white shadow-2xl">
    <div class="flex shrink-0 items-center justify-between border-b border-slate-200 px-6 py-4">
      <h2 id="room-title" class="text-lg font-semibold">Charge to room</h2>
      <button type="button" class="btn btn-ghost p-2" data-modal-close aria-label="Close" data-shortcut="dialog-close" data-shortcut-hint="none">{{icon "x"}}</button>
    </div>
    <div class="scroll-thin min-h-0 overflow-y-auto px-6 py-5">
      <div class="mb-4 flex items-center justify-between rounded-xl bg-accent-50 px-4 py-3">
        <span class="text-sm text-accent-700">Amount to charge</span><span id="room-amount" class="text-2xl font-semibold text-accent-800">0.00</span>
      </div>
      <!-- Step 1: room lookup -->
      <div id="room-step-lookup" class="space-y-3">
        <label class="label" for="room-number">Guest room number</label>
        <div class="flex flex-col gap-2 sm:flex-row">
          <input id="room-number" class="input text-lg" maxlength="20" placeholder="e.g. 205" autocomplete="off" inputmode="numeric">
          <button type="button" id="room-validate" class="btn btn-primary h-12 shrink-0" data-primary data-shortcut="dialog-primary"><span data-label>Validate with PMS</span></button>
        </div>
        <p class="text-xs text-slate-500">The room number is only a lookup. The PMS confirms the checked-in guest, the active folio and charge eligibility.</p>
      </div>
      <!-- Step 2: confirm PMS-validated details -->
      <div id="room-step-confirm" class="hidden space-y-3">
        <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-sm">
          <p class="mb-2 flex items-center gap-2 font-medium text-emerald-800">{{icon "check" "w-4 h-4"}}Validated by PMS</p>
          <dl class="dl">
            <dt>Room</dt><dd id="room-c-room" class="font-semibold"></dd>
            <dt>Guest</dt><dd id="room-c-guest" class="font-semibold"></dd>
            <dt>Folio</dt><dd id="room-c-folio" class="font-mono"></dd>
            <dt>Stay</dt><dd id="room-c-stay"></dd>
          </dl>
        </div>
        <p class="text-sm text-slate-600">Confirm with the guest that these details are correct before posting the charge.</p>
      </div>
      <!-- Step 3: result -->
      <div id="room-step-result" class="hidden"></div>
      <p id="room-error" class="mt-3 hidden rounded-lg bg-rose-50 px-3 py-2 text-sm text-rose-700" role="alert"></p>
      <p id="room-mock-note" class="mt-3 hidden text-xs text-amber-700">Mock PMS: 205 valid · 101 vacant · 102 no active folio · 103 not eligible · 404 PMS rejects · 306 timeout · 999 unknown.</p>
    </div>
    <div class="flex shrink-0 flex-wrap justify-end gap-2 rounded-b-2xl bg-slate-50 px-6 py-4">
      <button type="button" class="btn btn-cancel" data-modal-close id="room-cancel" data-shortcut="dialog-close">Cancel</button>
      <button type="button" class="btn btn-secondary hidden" id="room-back" data-shortcut="room-back">Use another room</button>
      <button type="button" class="btn btn-secondary hidden" id="room-verify" data-primary data-shortcut="dialog-primary"><span data-label>Check status with PMS</span></button>
      <button type="button" class="btn btn-accent btn-lg hidden" id="room-confirm" data-primary data-shortcut="dialog-primary"><span data-label>Post charge to folio</span></button>
    </div>
  </div>
</div>

<!-- Void -->
<div id="modal-void" class="pos-modal fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/60 p-4" role="dialog" aria-modal="true" aria-labelledby="void-title">
  <div class="flex max-h-full w-full max-w-md flex-col rounded-2xl bg-white shadow-2xl">
    <div class="shrink-0 border-b border-slate-200 px-6 py-4">
      <h2 id="void-title" class="text-lg font-semibold text-rose-700">Void order <span id="void-order-number" class="font-mono text-sm text-slate-500"></span></h2>
    </div>
    <div class="scroll-thin min-h-0 space-y-4 overflow-y-auto px-6 py-5">
      <p class="text-sm text-slate-600">Voiding cancels the whole order. It is recorded in the audit log and cannot be undone.</p>
      <div><label class="label" for="void-reason">Reason</label><input id="void-reason" class="input" maxlength="255" placeholder="Guest cancelled, wrong order…" autocomplete="off"></div>
      <div id="void-supervisor" class="hidden space-y-3 rounded-lg border border-amber-200 bg-amber-50 p-3">
        <p class="text-sm font-medium text-amber-800">Supervisor authorization required</p>
        <label class="sr-only" for="void-sup-user">Supervisor username</label>
        <input id="void-sup-user" class="input" placeholder="Supervisor username" autocomplete="off">
        <label class="sr-only" for="void-sup-pass">Supervisor password</label>
        <input id="void-sup-pass" class="input" type="password" placeholder="Supervisor password" autocomplete="off">
      </div>
      <p id="void-error" class="hidden rounded-lg bg-rose-50 px-3 py-2 text-sm text-rose-700" role="alert"></p>
    </div>
    <div class="flex shrink-0 justify-end gap-2 rounded-b-2xl bg-slate-50 px-6 py-4">
      <button type="button" class="btn btn-cancel" data-modal-close data-shortcut="dialog-close">Cancel</button>
      <button type="button" id="void-submit" class="btn btn-danger" data-primary data-shortcut="dialog-primary"><span data-label>Void order</span></button>
    </div>
  </div>
</div>

<!-- Notes -->
<div id="modal-note" class="pos-modal fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/60 p-4" role="dialog" aria-modal="true" aria-labelledby="note-title">
  <div class="flex max-h-full w-full max-w-md flex-col rounded-2xl bg-white shadow-2xl">
    <div class="shrink-0 border-b border-slate-200 px-6 py-4"><h2 id="note-title" class="text-lg font-semibold">Note</h2></div>
    <div class="scroll-thin min-h-0 overflow-y-auto px-6 py-5">
      <label class="sr-only" for="note-text">Note text</label>
      <textarea id="note-text" class="input" rows="3" maxlength="255" placeholder="No onions, extra ice…"></textarea>
      <p class="pos-hint mt-1 text-xs text-slate-500"><kbd class="kbd">Enter</kbd> saves · <kbd class="kbd">Shift+Enter</kbd> new line</p>
      <p id="note-error" class="mt-2 hidden rounded-lg bg-rose-50 px-3 py-2 text-sm text-rose-700" role="alert"></p>
    </div>
    <div class="flex shrink-0 justify-end gap-2 rounded-b-2xl bg-slate-50 px-6 py-4">
      <button type="button" class="btn btn-cancel" data-modal-close data-shortcut="dialog-close">Cancel</button>
      <button type="button" id="note-save" class="btn btn-primary" data-primary data-shortcut="dialog-primary"><span data-label>Save note</span></button>
    </div>
  </div>
</div>

<!-- Quantity -->
<div id="modal-qty" class="pos-modal fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/60 p-4" role="dialog" aria-modal="true" aria-labelledby="qty-title">
  <div class="flex max-h-full w-full max-w-sm flex-col rounded-2xl bg-white shadow-2xl">
    <div class="shrink-0 border-b border-slate-200 px-6 py-4">
      <h2 id="qty-title" class="text-lg font-semibold">Set quantity</h2>
      <p id="qty-product" class="truncate text-sm text-slate-500"></p>
    </div>
    <div class="scroll-thin min-h-0 overflow-y-auto px-6 py-5">
      <label class="label" for="qty-input">Quantity <span id="qty-unit" class="font-normal text-slate-500"></span></label>
      <input id="qty-input" type="number" min="0.001" max="9999" step="any" inputmode="decimal" class="input text-2xl">
      <p class="help">Decimals are allowed for items sold by weight or volume.</p>
      <p id="qty-error" class="mt-2 hidden rounded-lg bg-rose-50 px-3 py-2 text-sm text-rose-700" role="alert"></p>
    </div>
    <div class="flex shrink-0 justify-end gap-2 rounded-b-2xl bg-slate-50 px-6 py-4">
      <button type="button" class="btn btn-cancel" data-modal-close data-shortcut="dialog-close">Cancel</button>
      <button type="button" id="qty-apply" class="btn btn-primary" data-primary data-shortcut="dialog-primary"><span data-label>Set quantity</span></button>
    </div>
  </div>
</div>

<!-- Discounts -->
<div id="modal-discount" class="pos-modal fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/60 p-4" role="dialog" aria-modal="true" aria-labelledby="discount-title">
  <div class="flex max-h-full w-full max-w-lg flex-col rounded-2xl bg-white shadow-2xl">
    <div class="flex shrink-0 items-center justify-between border-b border-slate-200 px-6 py-4">
      <h2 id="discount-title" class="text-lg font-semibold">Apply discount</h2>
      <span class="pos-hint text-xs text-slate-500" data-kbd-for="discount-pick-1" data-label="… 9 or ↑ ↓"></span>
    </div>
    <div class="scroll-thin min-h-0 space-y-4 overflow-y-auto px-6 py-5">
      <fieldset>
        <legend class="sr-only">Available discounts</legend>
        <div id="discount-list" class="space-y-2"></div>
      </fieldset>
      <div id="discount-item-wrap" class="hidden">
        <label class="label" for="discount-item">Apply to item</label>
        <select id="discount-item" class="input"></select>
      </div>
      <div id="discount-supervisor" class="hidden space-y-3 rounded-lg border border-amber-200 bg-amber-50 p-3">
        <p class="text-sm font-medium text-amber-800">This discount requires supervisor authorization</p>
        <label class="sr-only" for="discount-sup-user">Supervisor username</label>
        <input id="discount-sup-user" class="input" placeholder="Supervisor username" autocomplete="off">
        <label class="sr-only" for="discount-sup-pass">Supervisor password</label>
        <input id="discount-sup-pass" class="input" type="password" placeholder="Supervisor password" autocomplete="off">
      </div>
      <p id="discount-error" class="hidden rounded-lg bg-rose-50 px-3 py-2 text-sm text-rose-700" role="alert"></p>
    </div>
    <div class="flex shrink-0 justify-end gap-2 rounded-b-2xl bg-slate-50 px-6 py-4">
      <button type="button" class="btn btn-cancel" data-modal-close data-shortcut="dialog-close">Cancel</button>
      <button type="button" id="discount-apply" class="btn btn-primary" data-primary data-shortcut="dialog-primary"><span data-label>Apply</span></button>
    </div>
  </div>
</div>

<!-- Open orders -->
<div id="modal-orders" class="pos-modal fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/60 p-4" role="dialog" aria-modal="true" aria-labelledby="orders-title">
  <div class="flex max-h-full w-full max-w-2xl flex-col rounded-2xl bg-white shadow-2xl">
    <div class="flex shrink-0 items-center justify-between gap-3 border-b border-slate-200 px-6 py-4">
      <h2 id="orders-title" class="text-lg font-semibold">Open orders at this outlet</h2>
      <button type="button" class="btn btn-ghost p-2" data-modal-close aria-label="Close" data-shortcut="dialog-close" data-shortcut-hint="none">{{icon "x"}}</button>
    </div>
    <div class="shrink-0 border-b border-slate-200 px-6 py-3">
      <label class="sr-only" for="orders-filter">Filter open orders</label>
      <input id="orders-filter" class="input" type="search" placeholder="Filter by order number, table, type or cashier" autocomplete="off">
    </div>
    <div id="orders-list" class="scroll-thin min-h-0 flex-1 overflow-y-auto" role="listbox" aria-label="Open orders"></div>
    <p class="pos-hint shrink-0 rounded-b-2xl bg-slate-50 px-6 py-2 text-xs text-slate-500"><kbd class="kbd">↑</kbd> <kbd class="kbd">↓</kbd> choose · <kbd class="kbd">Enter</kbd> open · <kbd class="kbd">Esc</kbd> close</p>
  </div>
</div>

<!-- Completed -->
<div id="modal-done" class="pos-modal fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/60 p-4" role="dialog" aria-modal="true" aria-labelledby="done-title">
  <div class="flex max-h-full w-full max-w-md flex-col rounded-2xl bg-white text-center shadow-2xl">
    <div class="scroll-thin min-h-0 overflow-y-auto px-6 pb-4 pt-8">
      <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-emerald-100 text-emerald-600">{{icon "check" "w-7 h-7"}}</div>
      <h2 id="done-title" class="mt-4 text-xl font-semibold">Order completed</h2>
      <p id="done-message" class="mt-2 text-sm text-slate-600"></p>
      <p id="done-change" class="mt-3 hidden text-2xl font-semibold text-emerald-700"></p>
    </div>
    <div class="flex shrink-0 flex-wrap justify-center gap-2 rounded-b-2xl bg-slate-50 px-6 py-4">
      <a id="done-receipt" href="#" target="_blank" rel="noopener" class="btn btn-secondary" data-shortcut="done-print">{{icon "printer" "w-4 h-4"}}Print receipt</a>
      <button type="button" class="btn btn-primary" data-action="new-order" data-modal-close data-primary data-autofocus data-shortcut="dialog-primary">New order</button>
    </div>
  </div>
</div>

<!-- Keyboard shortcuts (rendered from the registry in pos-shortcuts.js) -->
<div id="modal-help" class="pos-modal fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/60 p-4" role="dialog" aria-modal="true" aria-labelledby="help-title">
  <div class="flex max-h-full w-full max-w-4xl flex-col rounded-2xl bg-white shadow-2xl">
    <div class="flex shrink-0 flex-wrap items-center justify-between gap-3 border-b border-slate-200 px-6 py-4">
      <h2 id="help-title" class="text-lg font-semibold">Keyboard shortcuts</h2>
      <label class="flex items-center gap-2 text-sm text-slate-700">
        <input id="help-hints-toggle" type="checkbox" class="h-4 w-4 rounded border-slate-300 text-brand-700 focus:ring-brand-500">
        Show key badges on buttons
      </label>
    </div>
    <div id="help-groups" class="scroll-thin min-h-0 gap-x-8 overflow-y-auto px-6 py-5 md:columns-2"></div>
    <div class="flex shrink-0 items-center justify-between gap-2 rounded-b-2xl bg-slate-50 px-6 py-3">
      <p class="text-xs text-slate-500">Greyed shortcuts are not available for the current order. On button badges, ⇧ means Shift.</p>
      <button type="button" class="btn btn-secondary" data-modal-close data-autofocus data-shortcut="dialog-close">Close</button>
    </div>
  </div>
</div>
