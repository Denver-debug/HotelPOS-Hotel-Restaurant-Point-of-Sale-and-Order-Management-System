{{#if breadcrumbs}}
<nav class="mb-4 text-sm" aria-label="Breadcrumb">
  <ol class="flex flex-wrap items-center gap-1 text-slate-500">
    <li><a href="/dashboard" class="hover:text-brand-700">Home</a></li>
    {{#each breadcrumbs}}
      <li aria-hidden="true">/</li>
      <li>{{#if href}}<a href="{{href}}" class="hover:text-brand-700">{{label}}</a>{{else}}<span class="text-slate-700">{{label}}</span>{{/if}}</li>
    {{/each}}
  </ol>
</nav>
{{/if}}
