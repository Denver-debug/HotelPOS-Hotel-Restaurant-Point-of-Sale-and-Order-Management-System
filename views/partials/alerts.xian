{{#each success_msg}}
<div class="mb-4 flex items-start gap-3 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800" role="status" data-dismissible>
  {{icon "check" "w-5 h-5 shrink-0"}}<span class="flex-1">{{this}}</span>
  <button type="button" class="text-emerald-700/70 hover:text-emerald-900" data-dismiss aria-label="Dismiss">{{icon "x" "w-4 h-4"}}</button>
</div>
{{/each}}
{{#each error_msg}}
<div class="mb-4 flex items-start gap-3 rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800" role="alert" data-dismissible>
  {{icon "alert" "w-5 h-5 shrink-0"}}<span class="flex-1">{{this}}</span>
  <button type="button" class="text-rose-700/70 hover:text-rose-900" data-dismiss aria-label="Dismiss">{{icon "x" "w-4 h-4"}}</button>
</div>
{{/each}}
