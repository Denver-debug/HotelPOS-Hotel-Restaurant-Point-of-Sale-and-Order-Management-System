<!DOCTYPE html>
<html lang="en">
<head>
  {{> head}}
</head>
<body class="bg-ivory font-sans text-slate-800 antialiased">
  <a href="#main" class="sr-only z-50 rounded-lg bg-white px-4 py-2 text-sm font-medium text-brand-800 shadow focus:not-sr-only focus:fixed focus:left-4 focus:top-4">Skip to content</a>
  <div class="min-h-screen lg:pl-64">
    {{> sidebar}}
    <div class="flex min-h-screen flex-col">
      {{> topbar}}
      <main id="main" tabindex="-1" class="flex-1 px-4 py-6 focus:outline-none sm:px-6 lg:px-8">
        {{> breadcrumbs}}
        {{> alerts}}
        {{{body}}}
      </main>
      {{> footer}}
    </div>
  </div>
  {{> modal}}
  {{> scripts}}
</body>
</html>
