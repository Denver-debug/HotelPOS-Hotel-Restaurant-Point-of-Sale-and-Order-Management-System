<!DOCTYPE html>
<html lang="en">
<head>
  {{> head}}
</head>
<body class="bg-slate-100 font-sans text-slate-800 antialiased">
  <div class="min-h-screen lg:pl-64">
    {{> sidebar}}
    <div class="flex min-h-screen flex-col">
      {{> topbar}}
      <main class="flex-1 px-4 py-6 sm:px-6 lg:px-8">
        {{> breadcrumbs}}
        {{> alerts}}
        {{{body}}}
      </main>
      {{> footer}}
    </div>
  </div>
  {{> modal}}
  {{> scripts}}
</body>
</html>
