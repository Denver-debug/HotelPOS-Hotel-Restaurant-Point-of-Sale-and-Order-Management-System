<!DOCTYPE html>
<html lang="en">
<head>
  {{> head}}
</head>
<body class="min-h-screen bg-brand-950 font-sans text-slate-800 antialiased">
  <div class="flex min-h-screen items-center justify-center bg-[radial-gradient(ellipse_at_top,_#4D8C66_0%,_#1E422F_70%)] px-4 py-10">
    <div class="w-full max-w-md">
      <div class="mb-8 text-center">
        <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-accent-500 text-white shadow-lg">{{icon "key" "w-7 h-7"}}</div>
        <h1 class="mt-4 text-2xl font-semibold text-white">{{default appName "HotelPOS"}}</h1>
        <p class="mt-1 text-sm text-brand-200">{{hotelName}} · Restaurant &amp; Outlet Point-of-Sale</p>
      </div>
      {{{body}}}
      <p class="mt-8 text-center text-xs text-brand-300">Built on the XianFire framework</p>
    </div>
  </div>
  {{> scripts}}
</body>
</html>
