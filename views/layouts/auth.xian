<!DOCTYPE html>
<html lang="en">
<head>
  {{> head}}
</head>
<body class="min-h-screen bg-ivory font-sans text-slate-800 antialiased">
  <div class="flex min-h-screen">
    <!-- Hotel photo panel (large screens) -->
    <aside class="relative hidden overflow-hidden lg:flex lg:w-1/2 xl:w-[55%]">
      <img src="/images/hotel-lobby.jpg" alt="" class="absolute inset-0 h-full w-full object-cover">
      <div class="absolute inset-0 bg-gradient-to-t from-brand-950/90 via-brand-950/35 to-brand-950/10"></div>
      <div class="relative flex w-full flex-col justify-between p-10 xl:p-14">
        <a href="/" class="flex items-center gap-3">
          <img src="/images/logo.svg" alt="" class="h-11 w-11 shrink-0 drop-shadow">
          <span class="text-lg font-semibold tracking-tight text-white">{{default appName "HotelFlow"}}</span>
        </a>
        <div class="max-w-lg">
          <p class="text-sm font-medium uppercase tracking-widest text-accent-200">Staff portal</p>
          <h1 class="mt-3 text-4xl font-semibold leading-tight text-white">Welcome to {{default appName "HotelFlow"}}</h1>
          <p class="mt-4 text-lg text-brand-100">One point of sale for every outlet, from the restaurant floor to in-room dining.</p>
          <ul class="mt-8 flex flex-wrap gap-2 text-sm text-white">
            <li class="flex items-center gap-2 rounded-full bg-white/15 px-3 py-1.5 ring-1 ring-white/20 backdrop-blur">{{icon "utensils" "w-4 h-4"}}Restaurant</li>
            <li class="flex items-center gap-2 rounded-full bg-white/15 px-3 py-1.5 ring-1 ring-white/20 backdrop-blur">{{icon "cocktail" "w-4 h-4"}}Bar</li>
            <li class="flex items-center gap-2 rounded-full bg-white/15 px-3 py-1.5 ring-1 ring-white/20 backdrop-blur">{{icon "cloche" "w-4 h-4"}}In-room dining</li>
            <li class="flex items-center gap-2 rounded-full bg-white/15 px-3 py-1.5 ring-1 ring-white/20 backdrop-blur">{{icon "leaf" "w-4 h-4"}}Spa</li>
          </ul>
        </div>
      </div>
    </aside>

    <!-- Form panel -->
    <main class="flex flex-1 flex-col">
      <!-- Photo banner (small screens) -->
      <div class="relative h-44 overflow-hidden lg:hidden">
        <img src="/images/hotel-lobby.jpg" alt="" class="absolute inset-0 h-full w-full object-cover">
        <div class="absolute inset-0 bg-gradient-to-t from-brand-950/85 to-brand-950/20"></div>
        <a href="/" class="relative flex h-full items-end gap-3 px-4 pb-5 sm:px-8">
          <img src="/images/logo.svg" alt="" class="h-10 w-10 shrink-0 drop-shadow">
          <span class="pb-1.5 text-lg font-semibold tracking-tight text-white">{{default appName "HotelFlow"}}</span>
        </a>
      </div>
      <div class="flex flex-1 items-center justify-center px-4 py-10 sm:px-8">
        <div class="w-full max-w-md">
          {{{body}}}
          <p class="mt-8 text-center text-xs text-slate-400">{{default appName "HotelFlow"}} · Built on the XianFire framework</p>
        </div>
      </div>
    </main>
  </div>
  {{> scripts}}
</body>
</html>
