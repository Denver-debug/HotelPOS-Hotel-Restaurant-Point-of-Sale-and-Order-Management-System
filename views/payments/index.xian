{{#> page-header heading="Payments" subtitle="Direct payment history. Mock gateway transactions are labelled MOCK."}}{{/page-header}}
<div class="card">
  <form class="filter-bar" method="GET">
    <input aria-label="Payment number" class="input filter-wide" type="search" name="search" value="{{filters.search}}" placeholder="Payment number">
    <select aria-label="Outlet" class="input" name="outletId" data-autosubmit>
      <option value="">All outlets</option>
      {{#each outlets}}<option value="{{id}}" {{selected id ../filters.outletId}}>{{name}}</option>{{/each}}
    </select>
    <select aria-label="Payment method" class="input" name="methodId" data-autosubmit>
      <option value="">All methods</option>
      {{#each methods}}<option value="{{id}}" {{selected id ../filters.methodId}}>{{name}}</option>{{/each}}
    </select>
    <select aria-label="Status" class="input" name="status" data-autosubmit>
      <option value="">All statuses</option>
      {{#each statuses}}<option value="{{this}}" {{selected this ../filters.status}}>{{humanize this}}</option>{{/each}}
    </select>
    <select aria-label="Cashier" class="input" name="cashierId" data-autosubmit>
      <option value="">All cashiers</option>
      {{#each cashiers}}<option value="{{id}}" {{selected id ../filters.cashierId}}>{{fullName}}</option>{{/each}}
    </select>
    <input class="input" type="date" name="from" value="{{filters.from}}" aria-label="From">
    <input class="input" type="date" name="to" value="{{filters.to}}" aria-label="To">
    <button class="btn btn-secondary" type="submit">Filter</button>
  </form>
  {{#if payments.length}}
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>Payment</th><th>Date</th><th>Order</th><th>Outlet</th><th>Method</th><th>Reference</th><th class="text-right">Amount</th><th>Cashier</th><th>Status</th><th></th></tr></thead>
      <tbody>
        {{#each payments}}
        <tr>
          <td class="font-mono text-xs">{{paymentNumber}}</td>
          <td class="whitespace-nowrap text-xs">{{datetime createdAt}}</td>
          <td><a class="font-mono text-xs text-brand-700 hover:underline" href="/orders/{{order.id}}">{{order.orderNumber}}</a></td>
          <td class="whitespace-nowrap">{{order.outlet.code}}</td>
          <td>{{method.name}}{{#if isMock}} <span class="badge badge-slate">MOCK</span>{{/if}}</td>
          <td class="text-xs">{{default reference "—"}}{{#if externalTransactionId}}<div class="text-slate-400">{{externalTransactionId}}</div>{{/if}}{{#if failureReason}}<div class="text-rose-600">{{failureReason}}</div>{{/if}}</td>
          <td class="text-right font-medium">{{money amount}}{{#if (gt refundedAmount 0)}}<div class="text-xs text-rose-600">−{{money refundedAmount}}</div>{{/if}}</td>
          <td>{{processor.fullName}}</td>
          <td>{{statusBadge status}}</td>
          <td class="text-right">
            {{#if (and (eq status "PENDING") ../canVerify)}}
            <form method="POST" action="/payments/{{id}}/verify"><input type="hidden" name="_csrf" value="{{../csrfToken}}"><button class="btn btn-secondary btn-sm" type="submit">Verify</button></form>
            {{/if}}
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
  {{else}}
    {{> empty-state message="No payments in this period." icon="card"}}
  {{/if}}
  {{> pagination}}
</div>
