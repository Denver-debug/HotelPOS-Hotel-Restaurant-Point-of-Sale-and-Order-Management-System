{{#> page-header heading="Discounts & Promotions" subtitle="Applied at the POS terminal according to validity, outlet, product and permission rules."}}
  <a href="/discounts/new" class="btn btn-primary">{{icon "plus" "w-4 h-4"}}New discount</a>
{{/page-header}}
<div class="card">
  <form class="border-b border-slate-200 p-4" method="GET">
    <select class="input max-w-xs" name="status" data-autosubmit>
      <option value="">Active and inactive</option>
      <option value="ACTIVE" {{selected "ACTIVE" filters.status}}>Active</option>
      <option value="INACTIVE" {{selected "INACTIVE" filters.status}}>Inactive</option>
      <option value="ARCHIVED" {{selected "ARCHIVED" filters.status}}>Archived</option>
    </select>
  </form>
  {{#if discounts.length}}
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>Code</th><th>Name</th><th>Value</th><th>Applies to</th><th>Outlets</th><th>Validity</th><th class="text-right">Used</th><th>Approval</th><th>Status</th></tr></thead>
      <tbody>
        {{#each discounts}}
        <tr>
          <td><a class="font-mono text-xs font-medium text-brand-700 hover:underline" href="/discounts/{{id}}">{{code}}</a></td>
          <td>{{name}}<div class="text-xs text-slate-500">{{description}}</div></td>
          <td class="whitespace-nowrap">{{#if (eq discountType "PERCENTAGE")}}{{value}}%{{else}}{{money value}}{{/if}}</td>
          <td>{{#if (eq scope "ITEM")}}Item{{#if products.length}} ({{products.length}} products){{/if}}{{else}}Whole order{{/if}}</td>
          <td class="text-xs">{{#each outlets}}<span class="badge badge-slate mr-1">{{code}}</span>{{else}}All{{/each}}</td>
          <td class="whitespace-nowrap text-xs">{{#if validFrom}}{{date validFrom}}{{else}}—{{/if}} → {{#if validTo}}{{date validTo}}{{else}}—{{/if}}</td>
          <td class="text-right">{{timesUsed}}{{#if maxUses}} / {{maxUses}}{{/if}}</td>
          <td>{{#if requiresAuthorization}}<span class="badge badge-amber">Supervisor</span>{{else}}—{{/if}}</td>
          <td>{{statusBadge status}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
  {{else}}
    {{> empty-state message="No discounts defined." icon="percent"}}
  {{/if}}
</div>
